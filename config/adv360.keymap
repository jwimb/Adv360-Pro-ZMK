#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_de.h"

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        ThumbShift: ThumbShift {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMBSHIFT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <120>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp DE_CARET    &kp N1           &kp N2           &kp N3           &kp N4     &kp N5    &tog 4                                                                &mo 6                &kp N6  &kp N7  &kp N8     &kp N9       &kp N0         &kp DE_MINUS
&kp TAB         &kp X            &kp V            &kp L            &kp C      &kp W     &kp INSERT                                                            &kp DE_GRAVE         &kp K   &kp H   &kp G      &kp F        &kp Q          &none
&kp DE_SHARP_S  &kp U            &kp DE_I         &kp A            &kp E      &kp O     &kp PRINTSCREEN      &kp LCTRL      &kp ESC      &kp LGUI  &kp RCTRL  &kp DE_ACUTE         &kp S   &kp N   &kp R      &kp T        &kp D          &kp DE_Y
&kp LEFT_ALT    &kp DE_U_UMLAUT  &kp DE_O_UMLAUT  &kp DE_A_UMLAUT  &kp P      &kp DE_Z                                      &mo 2        &mo 2                                     &kp B   &kp M   &kp COMMA  &kp DOT      &kp J          &kp RIGHT_ALT
&mo 5           &kp DELETE       &kp CAPS         &kp LEFT         &kp RIGHT            &ThumbShift 1 SPACE  &kp BACKSPACE  &mo 3        &mo 3     &kp ENTER  &ThumbShift 1 SPACE          &kp UP  &kp DOWN   &kp PAGE_UP  &kp PAGE_DOWN  &mo 5
            >;
        };

        Neo2Shift {
            display-name = "3";
            bindings = <
&trans  &kp DE_DEGREE        &kp DE_DQT           &kp EXCL             &kp PRCNT     &kp DLLR      &tog 5                                      &mo 6   &kp AMPS      &kp DE_SLASH  &kp DE_LPAR       &kp DE_RIGHT_PARENTHESIS  &kp DE_EQUAL  &kp DE_UNDERSCORE
&trans  &kp LS(DE_X)         &kp LS(DE_V)         &kp LS(L)            &kp LS(DE_C)  &kp LS(DE_W)  &none                                       &none   &kp LS(DE_K)  &kp LS(H)     &kp LS(G)         &kp LS(F)                 &kp LS(Q)     &trans
&trans  &kp LS(U)            &kp LS(I)            &kp LS(A)            &kp LS(E)     &kp LS(O)     &none   &trans  &trans      &trans  &trans  &none   &kp LS(S)     &kp LS(N)     &kp LS(R)         &kp LS(T)                 &kp LS(D)     &kp LS(DE_Y)
&trans  &kp LS(DE_U_UMLAUT)  &kp LS(DE_O_UMLAUT)  &kp LS(DE_A_UMLAUT)  &kp LS(P)     &kp LS(DE_Z)                  &trans      &trans                  &kp LS(B)     &kp LS(M)     &kp DE_SEMICOLON  &kp DE_COLON              &kp LS(J)     &trans
&trans  &trans               &trans               &trans               &trans                      &trans  &trans  &trans      &trans  &trans  &trans                &trans        &trans            &trans                    &trans        &trans
            >;
        };

        Neo3 {
            display-name = "3";
            bindings = <
&trans  &kp RA(NUMBER_1)  &kp RA(NUMBER_2)   &kp RA(NUMBER_3)  &kp DE_GT     &kp DE_LT     &tog 5                                      &mo 6   &kp DE_EURO   &kp DE_LBRC     &kp DE_LBKT           &kp DE_RBKT          &kp DE_RBRC  &kp DE_BACKSLASH
&trans  &kp DE_PERIOD     &kp DE_UNDERSCORE  &kp DE_LBKT       &kp DE_RBKT   &kp DE_CARET  &none                                       &none   &kp DE_EXCL   &kp DE_LT       &kp GT                &kp DE_EQUAL         &kp DE_AMPS  &trans
&trans  &kp DE_BACKSLASH  &kp FSLH           &kp LBRC          &kp DE_RBRC   &kp DE_ASTRK  &none   &trans  &trans      &trans  &trans  &none   &kp DE_QMARK  &kp DE_LPAR     &kp DE_RPAR           &kp DE_MINUS         &kp COLON    &kp DE_AT
&trans  &kp DE_HASH       &kp DE_DOLLAR      &kp DE_PIPE       &kp DE_TILDE  &kp DE_GRAVE                  &trans      &trans                  &kp DE_PLUS   &kp DE_PERCENT  &kp DE_DOUBLE_QUOTES  &kp DE_SINGLE_QUOTE  &kp DE_SEMI  &trans
&trans  &trans            &trans             &trans            &trans                      &trans  &trans  &trans      &trans  &trans  &trans                &trans          &trans                &trans               &trans       &trans
            >;
        };

        Neo4 {
            display-name = "4";
            bindings = <
&trans  &kp RA(N1)  &kp RA(NUMBER_2)  &kp RA(N3)  &kp DE_GT  &kp DE_LT  &tog 5                                      &mo 6   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans      &trans            &trans      &trans     &trans     &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans            &trans      &trans     &trans     &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans            &trans      &trans     &trans                     &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans            &trans      &trans                &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 6      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 5      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 5
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 5                                      &mo 6   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
